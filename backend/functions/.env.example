# Resend sender domain must be verified in the Resend account.
RESEND_API_KEY=re_replace_with_your_key
RESEND_FROM_EMAIL=MintMotor <enquiries@your-verified-domain.example>
UKVD_API_BASE_URL=https://uk.api.vehicledataglobal.com/r2/lookup
# Keep secrets in Firebase Secret Manager; do not put live values in this file.
# Every Price ID must be a live, active GBP Price in the same Stripe account as STRIPE_SECRET_KEY.
# Seller: £10.00, recurring every one calendar month.
STRIPE_SELLER_PRICE_ID=price_replace_with_live_seller_monthly_price_id
STRIPE_DEALER_STARTER_PRICE_ID=price_replace_with_test_price_id
STRIPE_DEALER_GROWTH_PRICE_ID=price_replace_with_test_price_id
STRIPE_DEALER_SCALE_PRICE_ID=price_replace_with_test_price_id
STRIPE_DEALER_PRO_PRICE_ID=price_replace_with_test_price_id
STRIPE_DEALER_BUSINESS_PRICE_ID=price_replace_with_test_price_id
STRIPE_DEALER_ADVANCED_PRICE_ID=price_replace_with_test_price_id
STRIPE_DEALER_ENTERPRISE_PRICE_ID=price_replace_with_test_price_id
STRIPE_DEALER_150_PRICE_ID=price_replace_with_test_price_id
STRIPE_DEALER_200_PRICE_ID=price_replace_with_test_price_id
STRIPE_DEALER_300_PRICE_ID=price_replace_with_test_price_id
STRIPE_DEALER_400_PRICE_ID=price_replace_with_test_price_id
